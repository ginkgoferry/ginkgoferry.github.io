---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RightRail from '../components/RightRail.astro';
import Doodle from '../components/Doodle.astro';
import { FOCUS_TAGS, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/posts';

const posts = await getSortedPosts();
const recent = posts.slice(0, 3);

const COLORS = ['var(--red)', 'var(--blue)', 'var(--green)', 'var(--yellow)'];
// 贴纸大小错开一点，更像随手贴上去的
const SIZES = [1.12, 0.98, 1.06, 0.94];
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <p class="eyebrow">
      <Doodle name="arrow" class="arrow" />
      hello there
    </p>
    <h1><span class="underline-rough">{SITE_TITLE}</span></h1>
    <p class="lede">
      A hand-drawn notebook about code and everyday things.<br />
      Updated whenever I feel like it.
    </p>
    <p class="stickers" aria-label="things I'm into">
      {
        FOCUS_TAGS.map((tag, i) => (
          <span
            class="sticker"
            style={`color: ${COLORS[i % COLORS.length]}; --tilt: ${i % 2 ? 1.5 : -1.8}deg; font-size: ${SIZES[i % SIZES.length]}rem`}
          >
            {tag}
          </span>
        ))
      }
    </p>

    {/* 宽屏下填 hero 右侧的空白：一组随手涂鸦 */}
    <div class="hero-doodles" aria-hidden="true">
      <Doodle name="star" class="hd-star" />
      <Doodle name="arrow" class="hd-arrow" />
      <Doodle name="pencil" class="hd-pencil" />
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="recent">
        <h2 class="section-title">
          recently scribbled
          <span class="squiggle"></span>
        </h2>
        <div class="cards">
          {recent.map((post, i) => <PostCard post={post} index={i} />)}
        </div>
        {
          posts.length > recent.length && (
            <p class="more">
              <a href="/posts/">browse all {posts.length} posts →</a>
            </p>
          )
        }
      </section>
    )
  }

  <Fragment slot="rail">
    <RightRail showRecent={false} />
  </Fragment>
</BaseLayout>

<style>
  .hero {
    position: relative;
  }

  .hero h1 {
    margin-top: 0.6rem;
    font-size: clamp(2.1rem, 1.6rem + 2vw, 2.9rem);
  }

  /* 涂鸦组件的 svg 在子组件里，scoped 样式够不着，用 :global 穿透 */
  .hero-doodles {
    display: none;
  }

  @media (min-width: 1200px) {
    .hero-doodles {
      display: block;
      position: absolute;
      top: 0.25rem;
      right: 0;
      width: 12rem;
      height: 9.5rem;
      pointer-events: none;
    }

    .hero-doodles :global(.hd-star) {
      position: absolute;
      top: 0.2rem;
      right: 1.6rem;
      width: 2.1rem;
      height: 2.1rem;
      color: var(--yellow);
      transform: rotate(12deg);
    }

    .hero-doodles :global(.hd-arrow) {
      position: absolute;
      top: 2.9rem;
      right: 2.8rem;
      width: 4.6rem;
      height: 2.3rem;
      color: var(--red);
      transform: rotate(140deg);
    }

    .hero-doodles :global(.hd-pencil) {
      position: absolute;
      bottom: 0.2rem;
      right: 0.2rem;
      width: 2.7rem;
      height: 2.7rem;
      color: var(--blue);
      transform: rotate(-16deg);
    }
  }

  .lede {
    max-width: var(--measure);
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
  }

  .stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.55rem;
    margin: 1.8rem 0 0;
  }

  .recent {
    margin-top: 4.5rem;
  }

  .section-title {
    font-size: 1.3rem;
  }

  .section-title .squiggle {
    margin-top: 0.35rem;
    width: 6.5rem;
    color: var(--yellow);
  }

  .cards {
    display: grid;
    gap: 2.2rem;
    margin-top: 2rem;
  }

  .more {
    margin-top: 2rem;
  }

  .more a {
    color: var(--red);
  }
</style>
