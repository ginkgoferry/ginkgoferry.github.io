---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RightRail from '../../components/RightRail.astro';
import { getCategories } from '../../utils/posts';

const cats = await getCategories();
const COLORS = ['var(--red)', 'var(--blue)', 'var(--green)', 'var(--yellow)'];
---

<BaseLayout title="categories">
  <h1><span class="underline-rough">categories</span></h1>
  <p class="muted count">{cats.length} shelves</p>

  {
    cats.length === 0 ? (
      <p class="muted">
        The shelves are still empty — scribbles will be filed here once they
        are sorted into categories.
      </p>
    ) : (
      <div class="shelves">
        {
          cats.map((cat, i) => (
            <a
              href={`/categories/${cat.name}/`}
              class="shelf"
              style={`--tilt: ${i % 2 ? 0.7 : -0.7}deg`}
            >
              <span class="name" style={`color: ${COLORS[i % COLORS.length]}`}>
                § {cat.name}
              </span>
              <span class="squiggle"></span>
              <span class="n faint">
                {cat.posts.length} {cat.posts.length === 1 ? 'post' : 'posts'}
              </span>
            </a>
          ))
        }
      </div>
    )
  }

  <Fragment slot="rail">
    <RightRail />
  </Fragment>
</BaseLayout>

<style>
  .count {
    margin: 1rem 0 0;
  }

  .shelves {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1.6rem;
    margin-top: 2.5rem;
  }

  .shelf {
    display: block;
    background: var(--card);
    border: 1.6px solid var(--line-strong);
    border-radius: 6px 18px 8px 20px / 16px 7px 18px 8px;
    box-shadow: 3px 4px 0 var(--shadow);
    padding: 1.1rem 1.2rem 1rem;
    text-decoration: none;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .shelf:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow: 5px 7px 0 var(--shadow);
  }

  .shelf .name {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .shelf .squiggle {
    color: var(--line-strong);
    margin: 0.5rem 0 0.6rem;
  }
</style>
