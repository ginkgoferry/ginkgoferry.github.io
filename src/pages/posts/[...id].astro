---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TocRail from '../../components/TocRail.astro';
import TocFab from '../../components/TocFab.astro';
import Comments from '../../components/Comments.astro';
import { GOATCOUNTER_ID } from '../../consts';
import { getSortedPosts, readingTime, wordCount, formatCount } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post: CollectionEntry<'posts'>, index: number) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
const words = wordCount(post.body);
---

<BaseLayout
  title={post.data.title}
  type="article"
  lang="zh-CN"
>
  <article>
    <header>
      <h1><span class="underline-rough">{post.data.title}</span></h1>
      <p class="meta faint">
        {
          post.data.category && (
            <a class="cat" href={`/categories/${post.data.category}/`}>
              § {post.data.category}
            </a>
          )
        }
        <FormattedDate date={post.data.pubDate} />
        <span>{minutes} min read</span>
        <span>{formatCount(words)} words</span>
        {
          GOATCOUNTER_ID && (
            <span
              id="gc-views"
              hidden
              data-code={GOATCOUNTER_ID}
              data-path={Astro.url.pathname.replace(/\/$/, '')}
            ></span>
          )
        }
        {post.data.updatedDate && (
          <span>
            updated <FormattedDate date={post.data.updatedDate} compact />
          </span>
        )}
      </p>
      {
        post.data.tags.length > 0 && (
          <p class="tags">
            {post.data.tags.map((tag: string, i: number) => (
              <a
                href={`/tags/${tag}/`}
                class="sticker"
                style={`--tilt: ${i % 2 ? 1.3 : -1.5}deg`}
              >
                #{tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="post navigation">
    {
      older ? (
        <a href={`/posts/${older.id}/`} class="prev">
          <span class="faint">← older</span>
          {older.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a href={`/posts/${newer.id}/`} class="next">
          <span class="faint">newer →</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>

  <Comments />

  {
    GOATCOUNTER_ID && (
      <script is:inline>
        (function () {
          var el = document.getElementById('gc-views');
          if (!el) return;
          fetch(
            'https://' +
              el.dataset.code +
              '.goatcounter.com/counter/' +
              encodeURIComponent(el.dataset.path) +
              '.json',
          )
            .then(function (r) {
              return r.ok ? r.json() : Promise.reject();
            })
            .then(function (d) {
              el.hidden = false;
              el.textContent = d.count + ' views';
            })
            .catch(function () {});
        })();
      </script>
    )
  }

  <script is:inline>
    // 代码块复制：行号是 CSS 计数器画的，不在 DOM 文本里，复制出来是干净代码
    (function () {
      function flash(btn) {
        btn.textContent = 'copied!';
        btn.setAttribute('data-copied', '');
        setTimeout(function () {
          btn.textContent = 'copy';
          btn.removeAttribute('data-copied');
        }, 1600);
      }

      function legacyCopy(text, btn) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          // 已废弃但仍是唯一兜底：clipboard API 不可用时的最后手段
          if (document.execCommand('copy')) flash(btn);
        } catch (_) {
          /* 剪贴板不可用就保持原样 */
        }
        ta.remove();
      }

      document.addEventListener('click', function (e) {
        var btn = e.target instanceof Element ? e.target.closest('.code-copy') : null;
        if (!btn) return;
        var pre = btn.closest('.pre-wrap');
        pre = pre && pre.querySelector('pre');
        if (!pre) return;
        var text = pre.textContent || '';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(
            function () { flash(btn); },
            function () { legacyCopy(text, btn); },
          );
        } else {
          legacyCopy(text, btn);
        }
      });
    })();
  </script>

  <TocFab headings={headings} />

  <Fragment slot="rail">
    <TocRail headings={headings} />
  </Fragment>
</BaseLayout>

<style>
  article > header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1.6px dashed var(--line-strong);
  }

  h1 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 1.1rem 0 0;
  }

  .meta .cat {
    color: var(--blue);
    text-decoration: none;
    background: color-mix(in srgb, var(--blue) 10%, transparent);
    border-radius: 0.5em 0.2em 0.6em 0.3em;
    padding: 0.05em 0.4em;
  }

  .meta .cat:hover {
    color: var(--red);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1.6px dashed var(--line-strong);
    font-size: 1rem;
  }

  .pager a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .pager a:hover {
    color: var(--red);
  }

  .pager .next {
    text-align: right;
  }

  .pager span {
    display: block;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }
  }
</style>
