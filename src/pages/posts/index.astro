---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import RightRail from '../../components/RightRail.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts, POSTS_PER_PAGE } from '../../utils/posts';

const posts = await getSortedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
// 首页 = 分页的第 1 页；第 2 页起走 /posts/page/N/
const page = {
  data: posts.slice(0, POSTS_PER_PAGE),
  currentPage: 1,
  lastPage,
  urlPrev: undefined,
  urlNext: lastPage > 1 ? '/posts/page/2/' : undefined,
};
---

<BaseLayout title="posts">
  <h1><span class="underline-rough">posts</span></h1>
  <p class="muted count">{posts.length} notes in total</p>

  {
    posts.length === 0 ? (
      <p class="muted">
        The notebook is still empty — the first pages are being sketched. Check
        back soon.
      </p>
    ) : (
      <div class="cards">
        {page.data.map((post, i) => <PostCard post={post} index={i} />)}
      </div>
    )
  }

  <Pagination page={page} />

  <Fragment slot="rail">
    <RightRail />
  </Fragment>
</BaseLayout>

<style>
  .count {
    margin: 1rem 0 0;
  }

  .cards {
    display: grid;
    gap: 2.2rem;
    margin-top: 2.5rem;
  }
</style>
