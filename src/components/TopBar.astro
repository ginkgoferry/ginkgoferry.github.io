---
import Doodle from './Doodle.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';
import { SITE_TITLE } from '../consts';
import {
  formatCount,
  getLatestUpdatedDate,
  getSiteStats,
  getSortedPosts,
} from '../utils/posts';

const stats = await getSiteStats();
const latestUpdate = getLatestUpdatedDate(await getSortedPosts());
// 同年只显示 MM-DD；跨年（翻旧账）时带上年份免得歧义
const updated = latestUpdate
  ? `${latestUpdate.getFullYear() === new Date().getFullYear() ? '' : latestUpdate.getFullYear() + '-'}${String(latestUpdate.getMonth() + 1).padStart(2, '0')}-${String(latestUpdate.getDate()).padStart(2, '0')}`
  : '—';
---

<header class="topbar">
  <span>
    <Doodle name="pencil" />
    {SITE_TITLE}'s sketchbook
  </span>
  <span class="grow"></span>
  <span class="num">
    {stats.posts} {stats.posts === 1 ? 'post' : 'posts'} · {formatCount(stats.words)} words · updated {updated}
  </span>
  <SearchModal />
  <ThemeToggle />
</header>
