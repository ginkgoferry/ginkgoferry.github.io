---
import Doodle from './Doodle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { formatChars, getSiteStats, getSortedPosts } from '../utils/posts';

const stats = await getSiteStats();
const latest = (await getSortedPosts())[0];
const updated = latest
  ? `${String(latest.data.pubDate.getMonth() + 1).padStart(2, '0')}-${String(latest.data.pubDate.getDate()).padStart(2, '0')}`
  : '—';
---

<header class="topbar">
  <span>
    <Doodle name="pencil" />
    {SITE_TITLE}'s sketchbook
  </span>
  <span class="grow"></span>
  <span class="num">
    {stats.posts} {stats.posts === 1 ? 'post' : 'posts'} · {formatChars(stats.chars)} words · updated {updated}
  </span>
  <ThemeToggle />
</header>
