---
import { GISCUS } from '../consts';

// repo 留空 = 关闭评论，整个组件不渲染任何东西
const enabled = Boolean(GISCUS.repo);

// 自定义主题：public/ 下的两个 css（纸面/黑板），giscus 要求绝对 URL
const themeLight = new URL('giscus-light.css', Astro.site).href;
const themeDark = new URL('giscus-dark.css', Astro.site).href;
---

{
  enabled && (
    <section class="comments">
      <h2>comments</h2>
      <span class="squiggle"></span>
      <div
        class="giscus"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-theme-light={themeLight}
        data-theme-dark={themeDark}
      ></div>
    </section>
  )
}

{
    <script>
      // 视图切换后评论要按新文章重挂：giscus 按 pathname 映射讨论串。
      // astro:page-load 首次加载和每次导航后都触发；重挂前先断开旧的观察器。
      let giscusTeardown: (() => void) | null = null;
      document.addEventListener('astro:page-load', () => {
        giscusTeardown?.();
        giscusTeardown = null;

        const found = document.querySelector<HTMLElement>('.giscus');
        if (!found) return;
        // 守卫后重新绑定：闭包里不继承外部的控制流窄化
        const box = found;

        // 自定义主题：传 css 的 URL，而不是 giscus 内置主题名
        const theme = (): string =>
          document.documentElement.dataset.theme === 'dark'
            ? box.dataset.themeDark || ""
            : box.dataset.themeLight || "";

        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.setAttribute('data-repo', box.dataset.repo || '');
        s.setAttribute('data-repo-id', box.dataset.repoId || '');
        s.setAttribute('data-category', box.dataset.category || '');
        s.setAttribute('data-category-id', box.dataset.categoryId || '');
        s.setAttribute('data-mapping', 'pathname');
        s.setAttribute('data-strict', '0');
        s.setAttribute('data-reactions-enabled', '1');
        s.setAttribute('data-emit-metadata', '0');
        s.setAttribute('data-input-position', 'bottom');
        s.setAttribute('data-theme', theme());
        s.setAttribute('data-lang', 'zh-CN');
        s.setAttribute('data-loading', 'lazy');
        s.async = true;
        box.appendChild(s);

        // 切换黑板/纸面主题时，通知 giscus iframe 跟着换
        const observer = new MutationObserver(() => {
          const frame = box.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
          if (frame) {
            frame.contentWindow?.postMessage(
              { giscus: { setConfig: { theme: theme() } } },
              'https://giscus.app',
            );
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        giscusTeardown = () => observer.disconnect();
      });
    </script>
}

<style>
  .comments {
    margin-top: 4rem;
  }

  h2 {
    font-size: 1.3rem;
    margin: 0;
  }

  .squiggle {
    color: var(--line-strong);
    margin: 0.5rem 0 1.5rem;
  }
</style>
