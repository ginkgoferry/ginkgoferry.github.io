---
// 图片放大镜：正文里的截图点击 / 回车放大成"拍立得"，Esc 关闭，<-> 在图与图之间翻。
// 亮暗主题通用：底是深色幕布（像全屏看照片），不受 .prose 暗色压暗滤镜影响。
// 拍立得里不写图名（alt 多是截图文件名，没用还难看），只留 n / N 计数。
import Doodle from './Doodle.astro';
---

<dialog id="lightbox" aria-label="image viewer">
  <figure id="lightbox-frame" class="frame" tabindex="-1">
    <img id="lightbox-img" alt="" />
  </figure>
  <p id="lightbox-count" class="count"></p>
  <button id="lightbox-close" type="button" class="lb-btn lb-close" aria-label="close image">
    <Doodle name="close" />
  </button>
  <button id="lightbox-prev" type="button" class="lb-btn lb-prev" aria-label="previous image">
    <Doodle name="arrow" class="prev-arrow" />
  </button>
  <button id="lightbox-next" type="button" class="lb-btn lb-next" aria-label="next image">
    <Doodle name="arrow" class="next-arrow" />
  </button>
</dialog>

<style>
  dialog {
    border: none;
    background: none;
    padding: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
  }

  /* 关键：关掉时必须 display:none。
     裸 dialog{display:flex} 会盖住浏览器默认规则，
     close() 之后弹窗还渲染着，整页被透明层挡住点不动。 */
  dialog:not([open]) {
    display: none;
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
  }

  dialog::backdrop {
    background: rgba(16, 13, 9, 0.82);
  }

  .frame {
    margin: 0;
    max-width: min(92vw, 68rem);
    background: var(--card);
    border: 1.6px solid var(--line-strong);
    border-radius: 8px 4px 10px 5px / 5px 10px 4px 8px;
    box-shadow: 6px 8px 0 rgba(0, 0, 0, 0.35);
    padding: 0.7rem;
    transform: rotate(-0.7deg);
  }

  /* 只当打开弹窗时的焦点落脚点，不画任何焦点环 */
  .frame:focus,
  .frame:focus-visible {
    outline: none;
  }

  .frame img {
    display: block;
    max-width: 100%;
    max-height: 74vh;
    width: auto;
    height: auto;
  }

  .count {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: #d8d2c2;
    font-size: 0.95rem;
  }

  .count:empty {
    display: none;
  }

  /* 和顶栏搜索按钮同款手感：hover 歪一点、浮起来一点、影子加深 */
  .lb-btn {
    position: fixed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    background: var(--card);
    border: 1.6px solid var(--line-strong);
    border-radius: 1.2rem 0.9rem 1.3rem 0.8rem / 0.9rem 1.3rem 0.8rem 1.2rem;
    color: var(--ink-soft);
    box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition:
      color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
    transform: rotate(-1.5deg);
  }

  .lb-btn:hover {
    color: var(--red);
    box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.35);
  }

  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
  }

  .lb-close:hover {
    transform: rotate(4deg) translateY(-2px);
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    margin-top: -1.15rem;
  }

  .lb-prev {
    left: 1rem;
    transform: rotate(-2deg);
  }

  .lb-prev:hover {
    transform: rotate(-4deg) translateY(-2px);
  }

  .lb-next {
    right: 1rem;
    transform: rotate(1.5deg);
  }

  .lb-next:hover {
    transform: rotate(4deg) translateY(-2px);
  }

  .lb-prev :global(.prev-arrow),
  .lb-next :global(.next-arrow) {
    width: 1.4rem;
    height: 0.75rem;
  }

  /* 涂鸦箭头本来朝右、拱朝上；水平镜像 = 朝左且拱仍朝上
     （rotate(180deg) 会把拱翻到下面去） */
  .lb-prev :global(.prev-arrow) {
    transform: scaleX(-1);
  }
</style>

<script>  (function () {
    interface LightboxCtx {
      dialog: HTMLDialogElement;
      stage: HTMLElement;
      view: HTMLImageElement;
      count: HTMLElement;
      prevBtn: HTMLButtonElement;
      nextBtn: HTMLButtonElement;
      closeButton: HTMLButtonElement;
      images: HTMLImageElement[];
      single: boolean;
    }

    let ctx: LightboxCtx | null = null;
    let current = 0;
    let trigger: HTMLElement | null = null; // 打开时焦点来自哪张图，关掉后还回去

    function show(i: number): void {
      if (!ctx) return;
      const images = ctx.images;
      current = ((i % images.length) + images.length) % images.length;
      const source = images[current];
      const view = ctx.view;
      // 普通屏正在用 750w 变体时也直接用原图放大，不做二次下载
      view.src = source.currentSrc || source.src;
      if (source.getAttribute('srcset')) {
        view.setAttribute('srcset', source.getAttribute('srcset') || '');
      } else {
        view.removeAttribute('srcset');
      }
      view.alt = source.alt || '';
      if (!ctx.single) ctx.count.textContent = current + 1 + ' / ' + images.length;
    }

    function open(i: number, el: HTMLElement | null): void {
      if (!ctx) return;
      trigger = el;
      show(i);
      ctx.dialog.showModal();
      // 焦点落在画框上：保住键盘上下文，又不会一打开就在按钮上画红虚线框
      ctx.stage.focus({ preventScroll: true });
    }

    // 视图切换后正文 DOM 换掉：上下文（图集、按钮引用）在每次
    // astro:page-load 重建；dialog 元素是新的，监听挂它身上随旧 DOM 丢弃。
    document.addEventListener('astro:page-load', () => {
      ctx = null;
      const dlg = document.getElementById(
        'lightbox',
      ) as HTMLDialogElement | null;
      const frame = document.getElementById(
        'lightbox-frame',
      ) as HTMLElement | null;
      const img = document.getElementById(
        'lightbox-img',
      ) as HTMLImageElement | null;
      const countEl = document.getElementById('lightbox-count');
      const prev = document.getElementById(
        'lightbox-prev',
      ) as HTMLButtonElement | null;
      const next = document.getElementById(
        'lightbox-next',
      ) as HTMLButtonElement | null;
      const closeBtn = document.getElementById(
        'lightbox-close',
      ) as HTMLButtonElement | null;
      if (!dlg || !frame || !img || !countEl || !prev || !next || !closeBtn)
        return;

      const images = Array.from(
        document.querySelectorAll<HTMLImageElement>('.prose img'),
      );
      if (!images.length) return;

      const single = images.length < 2;
      prev.hidden = single;
      next.hidden = single;
      countEl.hidden = single;

      // 让截图能被 Tab 聚焦、回车打开
      images.forEach((el) => {
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'button');
        const alt = el.getAttribute('alt') || '';
        el.setAttribute(
          'aria-label',
          alt ? `放大查看图片：${alt}` : '放大查看图片',
        );
      });

      ctx = {
        dialog: dlg,
        stage: frame,
        view: img,
        count: countEl,
        prevBtn: prev,
        nextBtn: next,
        closeButton: closeBtn,
        images,
        single,
      };

      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        else if (e.key === 'ArrowRight') show(current + 1);
      });
      prev.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
      closeBtn.addEventListener('click', () => dlg.close());
      // 点幕布关闭（figure 以外的 dialog 区域）
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
      dlg.addEventListener('close', () => {
        if (trigger instanceof HTMLElement) trigger.focus();
        trigger = null;
      });
    });

    // 事件委托绑在 document 上，一次绑定对所有页面生效
    document.addEventListener('click', (e) => {
      if (!ctx || !(e.target instanceof Element)) return;
      const hit = e.target.closest('.prose img');
      if (!hit) return;
      const index = ctx.images.indexOf(hit as HTMLImageElement);
      if (index === -1) return;
      e.preventDefault();
      open(index, hit as HTMLElement);
    });

    document.addEventListener('keydown', (e) => {
      if (!ctx || (e.key !== 'Enter' && e.key !== ' ')) return;
      if (!(e.target instanceof Element) || !e.target.matches('.prose img'))
        return;
      const index = ctx.images.indexOf(e.target as HTMLImageElement);
      if (index === -1) return;
      e.preventDefault();
      open(index, e.target as HTMLElement);
    });
  })();
</script>
