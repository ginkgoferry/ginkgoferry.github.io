---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <section aria-labelledby="toc-title">
      <h2 id="toc-title" class="rail-title">on this page</h2>
      <span class="squiggle"></span>
      <ol class="toc" data-toc-scroll>
        {
          items.map((h) => (
            <li class={h.depth === 3 ? 'sub' : undefined}>
              <a href={`#${h.slug}`} data-toc-link>{h.text}</a>
            </li>
          ))
        }
      </ol>
    </section>
  )
}

{
  items.length > 0 && (
    <script>
      // 视图切换后正文 DOM 整个换掉，滚监听必须重新挂：
      // astro:page-load 在首次加载和每次导航后都会触发，重挂前先拆旧监听。
      let tocTeardown: (() => void) | null = null;
      document.addEventListener('astro:page-load', () => {
        tocTeardown?.();
        tocTeardown = null;

        const links = Array.from(document.querySelectorAll('[data-toc-link]'));
        if (!links.length) return;

        const headingById = new Map<string, HTMLElement | null>();
        links.forEach((link) => {
          const raw = link.getAttribute('href') || '';
          if (!raw.startsWith('#')) return;
          let id = raw.slice(1);
          try {
            id = decodeURIComponent(id);
          } catch {
            /* 编码坏的锚点就按原样找 */
          }
          if (!headingById.has(id)) headingById.set(id, document.getElementById(id));
        });
        const headings = Array.from(headingById.values()).filter(
          (h): h is HTMLElement => Boolean(h),
        );
        if (!headings.length) return;

        let activeId = '';
        let ticking = false;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function linkId(link: Element): string {
          const raw = link.getAttribute('href') || '';
          try {
            return decodeURIComponent(raw.slice(1));
          } catch {
            return raw.slice(1);
          }
        }

        function keepVisible(link: Element): void {
          const scroller = link.closest('[data-toc-scroll]');
          if (!scroller || (scroller as HTMLElement).offsetParent === null) return;
          const item = link.closest('li') || link;
          const box = scroller.getBoundingClientRect();
          const rect = item.getBoundingClientRect();
          const padding = 10;
          let next = scroller.scrollTop;

          if (rect.top < box.top + padding) next -= box.top + padding - rect.top;
          else if (rect.bottom > box.bottom - padding) {
            next += rect.bottom - box.bottom + padding;
          }

          if (next !== scroller.scrollTop) {
            scroller.scrollTo({
              top: next,
              behavior: reduceMotion.matches ? 'auto' : 'smooth',
            });
          }
        }

        function select(id: string, reveal: boolean): void {
          if (!id) return;
          activeId = id;
          links.forEach((link) => {
            const current = linkId(link) === id;
            if (current) {
              link.setAttribute('aria-current', 'location');
              if (reveal) keepVisible(link);
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }

        function update(reveal: boolean): void {
          ticking = false;
          const topbar = document.querySelector('.topbar');
          const threshold =
            (topbar ? topbar.getBoundingClientRect().height : 48) + 32;
          let current = headings[0];

          for (const h of headings) {
            if (h.getBoundingClientRect().top <= threshold) current = h;
            else break;
          }

          if (
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 2
          ) {
            current = headings[headings.length - 1];
          }
          select(current.id, reveal || current.id !== activeId);
        }

        function schedule(): void {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => update(true));
        }

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        window.addEventListener('hashchange', schedule);
        document.querySelectorAll('.toc-fab').forEach((details) => {
          details.addEventListener('toggle', () => {
            if ((details as HTMLDetailsElement).open) {
              requestAnimationFrame(() => update(true));
            }
          });
        });
        links.forEach((link) => {
          link.addEventListener('click', () => select(linkId(link), true));
        });
        update(true);

        tocTeardown = () => {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
          window.removeEventListener('hashchange', schedule);
        };
      });
    </script>
  )
}

<style>
  .toc {
    list-style: none;
    margin: 0;
    padding: 0 0.35rem 0 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .toc li + li {
    margin-top: 0.6rem;
  }

  .toc .sub {
    padding-left: 1rem;
    color: var(--ink-faint);
  }

  .toc a {
    position: relative;
    display: block;
    margin-right: 0.2rem;
    padding: 0.08rem 0.35rem;
    border-radius: 7px 3px 9px 4px / 4px 9px 3px 7px;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .toc a:hover {
    color: var(--red);
    text-decoration: underline;
    text-decoration-style: wavy;
  }

  .toc a[aria-current='location'] {
    color: var(--ink);
    background: var(--highlight);
  }

  .toc a[aria-current='location']::before {
    content: '→';
    position: absolute;
    right: calc(100% + 0.25rem);
    color: var(--red);
    transform: rotate(-5deg);
  }
</style>
