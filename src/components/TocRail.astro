---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <section>
      <h2 class="rail-title">on this page</h2>
      <span class="squiggle"></span>
      <ol class="toc">
        {
          items.map((h) => (
            <li class={h.depth === 3 ? 'sub' : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))
        }
      </ol>
    </section>
  )
}

<style>
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .toc li + li {
    margin-top: 0.6rem;
  }

  .toc .sub {
    padding-left: 1rem;
    color: var(--ink-faint);
  }

  .toc a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .toc a:hover {
    color: var(--red);
    text-decoration: underline;
    text-decoration-style: wavy;
  }
</style>
