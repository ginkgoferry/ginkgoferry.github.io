---
import Doodle from './Doodle.astro';
---

<button id="search-open" type="button" class="search-btn wobble-a" aria-label="search">
  <Doodle name="search" />
</button>

<dialog id="search-dialog" aria-label="search the notebook">
  <div class="dialog-top">
    <span>search the notebook</span>
    <button id="search-close" type="button" class="close-btn" aria-label="close search">
      <Doodle name="close" />
    </button>
  </div>
  <label for="search-input" class="sr-only">search posts</label>
  <input
    id="search-input"
    type="search"
    placeholder="search titles, tags, content…"
    autocomplete="off"
    aria-controls="search-results"
    aria-describedby="search-status"
  />
  <p id="search-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
  <ul id="search-results" class="results" aria-label="search results"></ul>
</dialog>

<style>
  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: var(--card);
    border: 1.6px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 1.05rem;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .search-btn:hover {
    color: var(--red);
    transform: rotate(5deg);
  }

  dialog {
    border: 1.6px solid var(--line-strong);
    border-radius: 10px 4px 12px 6px / 6px 12px 4px 10px;
    background: var(--card);
    color: var(--ink);
    padding: 1.3rem 1.4rem;
    width: min(34rem, calc(100vw - 2rem));
    box-shadow: 4px 6px 0 var(--shadow);
  }

  dialog::backdrop {
    background: rgba(20, 16, 10, 0.4);
  }

  .dialog-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: -0.15rem 0.05rem 0.9rem 0.1rem;
    color: var(--ink-soft);
  }

  .close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1.6px solid var(--line-strong);
    border-radius: 5px 2px 6px 3px / 3px 6px 2px 5px;
    background: var(--paper);
    color: var(--ink-soft);
    box-shadow: 2px 2px 0 var(--shadow);
    font-size: 1.05rem;
    cursor: pointer;
    transform: rotate(-1.5deg);
    transition: color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .close-btn:hover {
    color: var(--red);
    box-shadow: 3px 4px 0 var(--shadow);
    transform: rotate(2deg) translateY(-1px);
  }

  input {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1.6px solid var(--line-strong);
    border-radius: 8px 3px 9px 4px / 4px 9px 3px 8px;
    padding: 0.45rem 0.8rem;
  }

  input:focus {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
  }

  .results {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-height: 50vh;
    overflow-y: auto;
  }

  .results:empty {
    margin: 0;
  }

  /* 结果 li 是运行时 JS 生成的，拿不到 scoped 属性，用 :global 穿透 */
  .results :global(li + li) {
    margin-top: 0.6rem;
  }

  .results :global(a) {
    text-decoration: none;
  }

  .results :global(a:hover),
  .results :global(a:focus-visible) {
    color: var(--red);
    text-decoration: underline;
    text-decoration-style: wavy;
  }

  .results :global(.when) {
    margin-left: 0.7rem;
    font-size: 0.85rem;
  }

  /* 正文命中时标题下面给一行上下文片段，命中词打上马克笔 */
  .results :global(.snippet) {
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .results :global(.snippet mark) {
    background: var(--highlight);
    color: inherit;
    padding: 0 0.12em;
    border-radius: 4px 2px 5px 2px / 2px 5px 2px 4px;
  }
</style>

<script>
  interface Entry {
    id: string;
    title: string;
    tags: string[];
    category: string | null;
    date: string;
    /** 正文纯文本，构建期生成（见 search-index.json.ts） */
    body: string;
  }

  (function () {
    const btn = document.getElementById('search-open');
    const dlg = document.getElementById(
      'search-dialog',
    ) as HTMLDialogElement | null;
    const input = document.getElementById(
      'search-input',
    ) as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const close = document.getElementById('search-close');
    const status = document.getElementById('search-status');
    if (!btn || !dlg || !input || !list || !close || !status) return;
    // 守卫后重新绑定：闭包里不继承外部的控制流窄化
    const openBtn = btn;
    const dialog = dlg;
    const field = input;
    const results = list;
    const closeBtn = close;
    const liveStatus = status;

    // 索引懒加载：第一次点开搜索才去取 JSON
    let data: Entry[] | null = null;
    async function load(): Promise<Entry[]> {
      if (data) return data;
      const r = await fetch('/search-index.json');
      data = (await r.json()) as Entry[];
      return data;
    }

    // 命中等级：0 标题 > 1 标签/分类 > 2 正文；同级保持时间倒序
    function hit(post: Entry, q: string): number {
      if (post.title.toLowerCase().indexOf(q) !== -1) return 0;
      if (
        (post.category || '').toLowerCase().indexOf(q) !== -1 ||
        post.tags.some((t) => t.toLowerCase().indexOf(q) !== -1)
      )
        return 1;
      if (post.body.toLowerCase().indexOf(q) !== -1) return 2;
      return -1;
    }

    // 正文命中位置前后截一小段，命中词由调用方包 <mark>
    function snippetOf(post: Entry, q: string): string[] | null {
      const body = post.body.toLowerCase();
      const at = body.indexOf(q);
      if (at === -1) return null;
      const start = Math.max(0, at - 16);
      const end = Math.min(post.body.length, at + q.length + 48);
      return [
        start > 0 ? '…' + post.body.slice(start, at) : post.body.slice(start, at),
        post.body.slice(at, at + q.length),
        end < post.body.length ? post.body.slice(at + q.length, end) + '…' : post.body.slice(at + q.length, end),
      ];
    }

    function render() {
      results.textContent = '';
      const q = field.value.trim().toLowerCase();
      if (!q) {
        liveStatus.textContent = 'type a word to search';
        return;
      }
      if (!data) return;

      const matches = data
        .map((p) => ({ post: p, level: hit(p, q) }))
        .filter((m) => m.level !== -1)
        .sort((a, b) => a.level - b.level);
      const hits = matches.slice(0, 10);

      if (!hits.length) {
        const empty = document.createElement('li');
        empty.className = 'muted';
        empty.textContent = 'no matches - try another word';
        results.appendChild(empty);
        liveStatus.textContent = 'no search results found';
        return;
      }

      hits.forEach(({ post }, index) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '/posts/' + post.id + '/';
        a.textContent = post.title;
        a.dataset.resultIndex = String(index);
        const when = document.createElement('span');
        when.className = 'when faint';
        when.textContent = post.date;
        li.appendChild(a);
        li.appendChild(when);

        // 标题没直接命中时，补一行正文片段帮读者确认
        if (post.title.toLowerCase().indexOf(q) === -1) {
          const parts = snippetOf(post, q);
          if (parts) {
            const p = document.createElement('p');
            p.className = 'snippet';
            p.appendChild(document.createTextNode(parts[0]));
            const mark = document.createElement('mark');
            mark.textContent = parts[1];
            p.appendChild(mark);
            p.appendChild(document.createTextNode(parts[2]));
            li.appendChild(p);
          }
        }

        results.appendChild(li);
      });

      liveStatus.textContent = matches.length > hits.length
        ? `showing ${hits.length} of ${matches.length} search results; enter opens the top hit, arrow keys move`
        : `${hits.length} search ${hits.length === 1 ? 'result' : 'results'} found; enter opens the top hit, arrow keys move`;
    }

    function resultLinks(): HTMLAnchorElement[] {
      return Array.from(results.querySelectorAll<HTMLAnchorElement>('a[data-result-index]'));
    }

    function focusResult(index: number) {
      const links = resultLinks();
      if (!links.length) return;
      const next = (index + links.length) % links.length;
      links[next].focus();
    }

    function openDialog() {
      dialog.showModal();
      field.focus();
      liveStatus.textContent = 'loading search index';
      load().then(render).catch(() => {
        liveStatus.textContent = 'search is temporarily unavailable';
      });
    }

    openBtn.addEventListener('click', openDialog);

    // Ctrl/Cmd+K：开关注图弹窗（开着时再按一次关闭）
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else openDialog();
      }
    });

    field.addEventListener('input', render);
    field.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        // 回车直接去第一个结果
        const first = resultLinks()[0];
        if (first) {
          event.preventDefault();
          first.click();
        }
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const links = resultLinks();
      if (!links.length) return;
      focusResult(event.key === 'ArrowDown' ? 0 : links.length - 1);
    });
    results.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const target = event.target;
      if (!(target instanceof HTMLAnchorElement)) return;
      const index = Number(target.dataset.resultIndex);
      if (!Number.isInteger(index)) return;
      event.preventDefault();
      focusResult(index + (event.key === 'ArrowDown' ? 1 : -1));
    });
    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => openBtn.focus());
    // 点遮罩关闭；Esc 由 <dialog> 原生处理
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  })();
</script>
