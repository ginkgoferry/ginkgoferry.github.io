---
import { LOCALE } from '../consts';

interface Props {
  date: Date;
  /** 列表里用紧凑格式，正文里用完整格式 */
  compact?: boolean;
}

const { date, compact = false } = Astro.props;

const formatted = date.toLocaleDateString(LOCALE, {
  year: 'numeric',
  month: compact ? 'numeric' : 'long',
  day: 'numeric',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
