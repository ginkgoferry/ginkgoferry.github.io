---
import Doodle from './Doodle.astro';
import { AUTHOR, GOATCOUNTER_ID } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer" transition:persist="footer">
  <span class="squiggle"></span>
  <p>© {year} {AUTHOR}. Some rights reserved.</p>
  {
    GOATCOUNTER_ID && (
      <p class="gc faint">
        <span id="gc-total" class="total-views" hidden data-code={GOATCOUNTER_ID}>
          <Doodle name="eye" class="views-icon" />
          <span class="views-count" data-count></span>
          <span>total views</span>
        </span>
        <a href={`https://${GOATCOUNTER_ID}.goatcounter.com/`} rel="noopener">
          stats by GoatCounter
        </a>
      </p>
    )
  }
</footer>

{
  GOATCOUNTER_ID && (
    <script is:inline>
      (function () {
        var el = document.getElementById('gc-total');
        if (!el) return;
        fetch(
          'https://' + el.dataset.code + '.goatcounter.com/counter/TOTAL.json',
        )
          .then(function (r) {
            return r.ok ? r.json() : Promise.reject();
          })
          .then(function (d) {
            var count = el.querySelector('[data-count]');
            if (!count) return;
            count.textContent = d.count;
            el.hidden = false;
          })
          .catch(function () {});
      })();
    </script>
  )
}

<style>
  p {
    margin: 0;
  }

  .gc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem 1.25rem;
    margin-top: 0.55rem;
  }

  .total-views {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .total-views[hidden] {
    display: none;
  }

  .views-count {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .total-views :global(.views-icon) {
    color: var(--blue);
    font-size: 1.05rem;
  }
</style>
