---
// 手绘涂鸦图标：全部是歪歪扭扭的线条 SVG，stroke 跟随 currentColor。
interface Props {
  name: 'arrow' | 'check' | 'close' | 'github' | 'mail' | 'sun' | 'moon' | 'star' | 'pencil' | 'search';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox={name === 'arrow' ? '0 0 32 16' : '0 0 16 16'}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'arrow' && (
    <path d="M2 12C9 5 18 4 28 8m-5-4c2 1.6 3.6 2.8 5 4-2.2.6-4 1.6-5.6 3.2" />
  )}
  {name === 'check' && (
    <>
      <path d="M2.5 3.2c3.6-.5 7.3-.6 11-.3.3 3.4.3 6.8 0 10.1-3.7.3-7.4.3-11 0-.4-3.3-.4-6.5 0-9.8Z" />
      <path d="M5 8.2c1 1.2 1.8 2.3 2.5 3.4 1.2-2.6 2.6-4.8 4.3-6.6" />
    </>
  )}
  {name === 'close' && (
    <>
      <path d="M3.7 3.5c2.8 2.9 5.7 5.8 8.7 8.9" />
      <path d="M12.5 3.6c-3 3-5.9 5.9-8.9 8.7" />
    </>
  )}
  {name === 'github' && (
    <>
      <path d="M8 2.4c-3.1 0-5.5 2.4-5.5 5.4 0 2.3 1.5 4.3 3.6 5.2m3.9 0c2.1-.9 3.5-2.9 3.5-5.2C13.5 4.8 11.1 2.4 8 2.4Z" />
      <path d="M3.5 4.3 2.9 2.2l2 .9m7.6 1.2.6-2.1-2 .9" />
    </>
  )}
  {name === 'mail' && (
    <>
      <path d="M1.9 4.4c4-.3 8.2-.3 12.2 0 .2 2.6.2 5.4 0 8-4 .3-8.2.3-12.2 0-.2-2.6-.2-5.4 0-8Z" />
      <path d="M2.2 4.9 8 9.5l5.8-4.6" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="8" cy="8" r="3.1" />
      <path d="M8 1.6v1.7M8 12.7v1.7M1.6 8h1.7M12.7 8h1.7M3.5 3.5l1.2 1.2M11.3 11.3l1.2 1.2M12.5 3.5l-1.2 1.2M4.7 11.3l-1.2 1.2" />
    </>
  )}
  {name === 'moon' && <path d="M13 9.6A5.4 5.4 0 0 1 6.4 3 5.6 5.6 0 1 0 13 9.6Z" />}
  {name === 'star' && (
    <path d="M8 1.8c.7 2 1.3 3.4 1.9 4.4 1.5.2 3 .4 4.4.7-1.2 1-2.3 2-3.3 3 .3 1.5.5 3 .7 4.5-1.3-.8-2.5-1.5-3.7-2.2-1.3.7-2.5 1.4-3.7 2.1.2-1.5.5-3 .8-4.5-1.1-1-2.2-2-3.4-3 1.5-.2 3-.4 4.5-.6C6.8 5.2 7.4 3.8 8 1.8Z" />
  )}
  {name === 'search' && (
    <>
      <circle cx="6.8" cy="6.8" r="4.1" />
      <path d="M10 10.2c1.3 1.1 2.4 2.2 3.4 3.4" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <path d="M3 13l.8-3L11 2.8c.8-.8 1.6-.8 2.3 0 .7.7.7 1.5 0 2.2L6 12.2 3 13Z" />
      <path d="M9.8 4l2.2 2.2" />
    </>
  )}
</svg>

<style>
  svg {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }
</style>
